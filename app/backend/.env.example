# Copia este archivo como .env (en esta misma carpeta, app/backend/) y rellena las claves.
# .env NO se sube a GitHub (está en app/.gitignore y en el .gitignore de la raíz).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aeropuerto

# Usuario de solo lectura (consultas, explorador, ER, calidad, rendimiento)
DB_RO_USER=app_ro
DB_RO_PASSWORD=

# Usuario con escritura mínima (CRUD y demo de triggers; se usa desde la fase 3)
DB_RW_USER=app_rw
DB_RW_PASSWORD=

# Servidor de la API (solo escucha en 127.0.0.1)
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
